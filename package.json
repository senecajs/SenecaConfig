{
  "name": "@seneca/config",
  "version": "0.6.0",
  "main": "dist/Config.js",
  "type": "commonjs",
  "types": "dist/Config.d.ts",
  "description": "Live configuration plugin for the Seneca framework.",
  "homepage": "https://github.com/senecajs/SenecaConfig",
